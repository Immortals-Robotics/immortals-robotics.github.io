---
// A team member: photo (or initials avatar), name, role/area and optional links.
import type { CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';

interface Props {
  member: CollectionEntry<'team'>;
}

const { name, role, area, photo, github, linkedin, website } = Astro.props.member.data;

const parts = name.trim().split(/\s+/);
const initials = (parts[0][0] + (parts.length > 1 ? parts[parts.length - 1][0] : '')).toUpperCase();

const links = [
  { href: github, label: 'GitHub', icon: 'M12 1.5a10.5 10.5 0 0 0-3.32 20.46c.53.1.72-.23.72-.5v-1.8c-2.92.63-3.54-1.4-3.54-1.4-.48-1.22-1.17-1.54-1.17-1.54-.95-.65.08-.64.08-.64 1.05.08 1.6 1.08 1.6 1.08.94 1.6 2.46 1.14 3.06.87.1-.68.37-1.14.66-1.4-2.33-.27-4.78-1.17-4.78-5.18 0-1.15.41-2.08 1.08-2.82-.1-.26-.47-1.33.1-2.78 0 0 .88-.28 2.88 1.07a10 10 0 0 1 5.24 0c2-1.35 2.88-1.07 2.88-1.07.57 1.45.21 2.52.1 2.78.67.74 1.08 1.67 1.08 2.82 0 4.02-2.46 4.9-4.8 5.17.38.33.71.97.71 1.96v2.9c0 .28.19.61.73.5A10.5 10.5 0 0 0 12 1.5Z' },
  { href: linkedin, label: 'LinkedIn', icon: 'M4.98 3.5a2.5 2.5 0 1 1 0 5 2.5 2.5 0 0 1 0-5ZM3 9.75h4v11H3v-11Zm6.5 0h3.83v1.5h.05c.53-1 1.84-2.06 3.8-2.06 4.05 0 4.8 2.67 4.8 6.14v5.42h-4v-4.8c0-1.15-.02-2.62-1.6-2.62-1.6 0-1.84 1.25-1.84 2.54v4.88h-4v-11Z' },
  { href: website, label: 'Website', icon: 'M12 2a10 10 0 1 0 0 20 10 10 0 0 0 0-20Zm6.93 6h-2.95a15.7 15.7 0 0 0-1.38-3.56A8.03 8.03 0 0 1 18.93 8ZM12 4.04c.83 1.2 1.48 2.53 1.91 3.96h-3.82c.43-1.43 1.08-2.76 1.91-3.96ZM4.26 14a8.2 8.2 0 0 1 0-4h3.38a16.5 16.5 0 0 0 0 4H4.26Zm.81 2h2.95c.32 1.25.78 2.45 1.38 3.56A8 8 0 0 1 5.07 16Zm2.95-8H5.07a8 8 0 0 1 4.33-3.56A15.7 15.7 0 0 0 8.02 8ZM12 19.96A14.1 14.1 0 0 1 10.09 16h3.82A14.1 14.1 0 0 1 12 19.96ZM14.34 14H9.66a14.7 14.7 0 0 1 0-4h4.68a14.7 14.7 0 0 1 0 4Zm.26 5.56c.6-1.11 1.06-2.31 1.38-3.56h2.95a8.03 8.03 0 0 1-4.33 3.56ZM16.36 14a16.5 16.5 0 0 0 0-4h3.38a8.2 8.2 0 0 1 0 4h-3.38Z' },
].filter((link) => link.href);
---

<article class="member">
  {
    photo ? (
      <Image class="avatar" src={photo} alt="" width={112} height={112} densities={[1, 2]} />
    ) : (
      <span class="avatar initials" aria-hidden="true">{initials}</span>
    )
  }
  <div class="info">
    <h3>{name}</h3>
    <p class="role">{role}</p>
    {area && <span class="chip">{area}</span>}
    {
      links.length > 0 && (
        <ul class="links" role="list">
          {links.map(({ href, label, icon }) => (
            <li>
              <a href={href} rel="noopener" aria-label={`${name} on ${label}`} title={label}>
                <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
                  <path fill="currentColor" d={icon} />
                </svg>
              </a>
            </li>
          ))}
        </ul>
      )
    }
  </div>
</article>

<style>
  .member {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    height: 100%;
    padding: 1.25rem;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--surface);
    box-shadow: var(--shadow);
  }

  .avatar {
    flex: none;
    width: 5.5rem;
    height: 5.5rem;
    border-radius: 50%;
    object-fit: cover;
  }

  .initials {
    display: grid;
    place-items: center;
    border: 2px solid var(--accent);
    background: var(--accent-soft);
    color: var(--accent);
    font-size: 1.75rem;
    font-weight: 800;
    letter-spacing: 0.04em;
  }

  .info {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.3rem;
    min-width: 0;
  }

  h3 {
    font-size: 1.15rem;
  }

  .role {
    color: var(--text-muted);
  }

  .links {
    display: flex;
    gap: 0.25rem;
    margin-top: 0.25rem;
    margin-left: -0.4rem;
    padding: 0;
    list-style: none;
  }

  .links a {
    display: grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: var(--radius-sm);
    color: var(--text-muted);
  }

  .links a:hover {
    background: var(--surface-2);
    color: var(--accent);
  }
</style>
