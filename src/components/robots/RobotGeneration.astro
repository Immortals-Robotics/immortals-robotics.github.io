---
// One robot generation: photo layout, name/year, summary, spec badges, Markdown body.
import type { CollectionEntry } from 'astro:content';
import { render } from 'astro:content';
import { Picture } from 'astro:assets';

interface Props {
  robot: CollectionEntry<'robots'>;
  /** Load the main photo eagerly (first generation on the page). */
  eager?: boolean;
}

const { robot, eager = false } = Astro.props;
const { name, year, summary, images, specs, current } = robot.data;
const { Content } = await render(robot);

// Main photo plus up to three extras stacked beside it. With `n` extras the main
// column is `n` times as wide, so every tile stays square.
const [main, ...rest] = images;
const extras = rest.slice(0, 3);
const label = [current && 'In service', year].filter(Boolean).join(' · ');
const headingId = `robot-${robot.id}`;
---

<article class="generation" aria-labelledby={headingId}>
  <div
    class="media"
    data-extras={extras.length}
    style={extras.length ? `grid-template-columns: ${extras.length}fr 1fr` : undefined}
  >
    <Picture
      pictureAttributes={{
        class: 'main',
        style: extras.length ? `grid-row: span ${extras.length}` : undefined,
      }}
      src={main.src}
      alt={main.alt}
      formats={['avif', 'webp']}
      widths={[360, 560, 800, 1080]}
      sizes="(min-width: 960px) 460px, 70vw"
      loading={eager ? 'eager' : 'lazy'}
    />
    {
      extras.map((img) => (
        <Picture
          src={img.src}
          alt={img.alt}
          formats={['avif', 'webp']}
          widths={[200, 320, 480]}
          sizes="(min-width: 960px) 160px, 25vw"
          loading={eager ? 'eager' : 'lazy'}
        />
      ))
    }
  </div>

  <div class="info">
    {label && <span class="eyebrow">{label}</span>}
    <h2 id={headingId}>{name}</h2>
    <p class="summary">{summary}</p>

    {
      specs.length > 0 && (
        <dl class="specs">
          {specs.map(({ label, value }) => (
            <div class="spec">
              <dt>{label}</dt>
              <dd>{value}</dd>
            </div>
          ))}
        </dl>
      )
    }

    <div class="prose body">
      <Content />
    </div>
  </div>
</article>

<style>
  .generation {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
    align-items: start;
    gap: clamp(1.5rem, 5vw, 4rem);
  }

  .media {
    display: grid;
    gap: clamp(0.5rem, 1.2vw, 0.75rem);
  }

  .media :global(img) {
    width: 100%;
    height: 100%;
    aspect-ratio: 1;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--surface-2);
    object-fit: cover;
  }

  /* The main photo fills whatever height the stacked extras give it. */
  .media:not([data-extras='0']) :global(.main) {
    position: relative;
  }

  .media:not([data-extras='0']) :global(.main img) {
    position: absolute;
    inset: 0;
    aspect-ratio: auto;
  }

  .media[data-extras='0'] :global(img) {
    aspect-ratio: 4 / 3;
  }

  .info {
    padding-top: 0.25rem;
  }

  .summary {
    margin-top: 0.75rem;
    color: var(--text-muted);
    font-size: 1.125rem;
  }

  .specs {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 1.5rem;
  }

  .spec {
    display: flex;
    flex-direction: column;
    padding: 0.5rem 0.85rem;
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    background: var(--surface);
    line-height: 1.3;
  }

  .spec dt {
    color: var(--text-muted);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .spec dd {
    color: var(--heading);
    font-family: var(--font-mono);
    font-weight: 600;
  }

  .body {
    margin-top: 1.5rem;
  }

  @media (max-width: 860px) {
    .generation {
      grid-template-columns: 1fr;
    }
  }
</style>
