---
// Small line icon for a publication group.
interface Props {
  icon: 'tdp' | 'paper' | 'thesis' | 'talk' | 'software' | 'other';
}

const PATHS: Record<Props['icon'], string> = {
  // Document with a round robot seen from above.
  tdp: 'M6 2.5h8l4 4V21.5H6zM14 2.5v4h4M12 9.5a2.75 2.75 0 1 1 0 5.5 2.75 2.75 0 0 1 0-5.5zM9 18.5h6',
  // Plain document with text lines.
  paper: 'M6 2.5h8l4 4V21.5H6zM14 2.5v4h4M9 11h6M9 14.5h6M9 18h6',
  // Graduation cap.
  thesis: 'M2 9l10-5 10 5-10 5zM6 11v5c0 1.5 3 3 6 3s6-1.5 6-3v-5M22 9v6',
  // Microphone.
  talk: 'M12 2.5a3 3 0 0 1 3 3v6a3 3 0 0 1-6 0v-6a3 3 0 0 1 3-3zM5.5 11a6.5 6.5 0 0 0 13 0M12 17.5v4M8.5 21.5h7',
  // Code brackets.
  software: 'M8 7l-5 5 5 5M16 7l5 5-5 5M14 4l-4 16',
  // Bookmark.
  other: 'M6 2.5h12v19l-6-4.5-6 4.5z',
};

const { icon } = Astro.props;
---

<svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
  <path
    d={PATHS[icon]}
    fill="none"
    stroke="currentColor"
    stroke-width="1.8"
    stroke-linecap="round"
    stroke-linejoin="round"></path>
</svg>
