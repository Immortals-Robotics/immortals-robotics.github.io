---
// Podium results flagged `highlight: true`, newest first, as medal badges.
import { getCollection } from 'astro:content';
import SectionHead from './SectionHead.astro';

const results = (await getCollection('achievements', ({ data }) => data.highlight)).sort(
  (a, b) => b.data.year - a.data.year,
);

const MEDALS: Record<number, string> = { 1: 'gold', 2: 'silver', 3: 'bronze' };

function ordinal(n: number) {
  const suffix = { one: 'st', two: 'nd', few: 'rd', other: 'th' } as const;
  const rule = new Intl.PluralRules('en', { type: 'ordinal' }).select(n) as keyof typeof suffix;
  return `${n}${suffix[rule] ?? 'th'}`;
}
---

{
  results.length > 0 && (
    <section class="section results" aria-labelledby="results-title">
      <div class="container">
        <SectionHead
          id="results-title"
          eyebrow="Results"
          title="On the podium"
          href="/achievements/"
          linkLabel="All results"
        />
        <ol class="result-list">
          {results.map(({ data }) => (
            <li class="result">
              <span class="medal" data-medal={data.place ? MEDALS[data.place] : undefined} aria-hidden="true">
                {data.place ?? '★'}
              </span>
              <div class="result-text">
                <span class="year">{data.year}</span>
                <strong class="place">{data.place ? `${ordinal(data.place)} place` : data.result}</strong>
                <span class="event">{data.event}</span>
                {(data.division || data.location) && (
                  <span class="meta">{[data.division, data.location].filter(Boolean).join(' · ')}</span>
                )}
              </div>
            </li>
          ))}
        </ol>
      </div>
    </section>
  )
}

<style>
  .result-list {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 240px), 1fr));
    gap: clamp(0.75rem, 2vw, 1.25rem);
    padding: 0;
    list-style: none;
  }

  .result {
    display: flex;
    align-items: flex-start;
    gap: 1rem;
    padding: 1.25rem;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--surface);
    box-shadow: var(--shadow);
  }

  .medal {
    --medal: var(--accent-bg);
    display: grid;
    flex: none;
    place-items: center;
    width: 3.25rem;
    height: 3.25rem;
    border-radius: 50%;
    background: var(--medal);
    box-shadow:
      inset 0 0 0 3px color-mix(in srgb, var(--bg) 35%, transparent),
      0 0 0 3px color-mix(in srgb, var(--medal) 25%, transparent);
    color: var(--bg);
    font-size: 1.5rem;
    font-weight: 800;
    line-height: 1;
  }

  .medal[data-medal='gold'] {
    --medal: var(--gold);
  }

  .medal[data-medal='silver'] {
    --medal: var(--silver);
  }

  .medal[data-medal='bronze'] {
    --medal: var(--bronze);
  }

  .result-text {
    display: flex;
    flex-direction: column;
    min-width: 0;
    line-height: 1.35;
  }

  .year {
    color: var(--text-muted);
    font-family: var(--font-mono);
    font-size: 0.85rem;
  }

  .place {
    margin-top: 0.1rem;
    color: var(--heading);
    font-size: 1.15rem;
  }

  .event {
    margin-top: 0.2rem;
  }

  .meta {
    margin-top: 0.2rem;
    color: var(--text-muted);
    font-size: 0.9rem;
  }

  /* Phones: two compact columns instead of a tall stack. */
  @media (max-width: 560px) {
    .result-list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .result {
      flex-direction: column;
      gap: 0.6rem;
      padding: 1rem;
    }

    .medal {
      width: 2.5rem;
      height: 2.5rem;
      font-size: 1.2rem;
    }

    .place {
      font-size: 1.05rem;
    }

    .event,
    .meta {
      font-size: 0.875rem;
    }
  }
</style>
