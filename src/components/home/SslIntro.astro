---
import { Picture } from 'astro:assets';
import lineup from '../../assets/robots/lineup-field.jpg';

const LIMITS = [
  { value: '11', label: 'robots per team, at most' },
  { value: '18 cm', label: 'maximum robot diameter' },
  { value: '15 cm', label: 'maximum robot height' },
];
---

<section class="section section-alt" aria-labelledby="ssl-title">
  <div class="container ssl">
    <div class="ssl-copy">
      <span class="eyebrow">The league</span>
      <h2 id="ssl-title">What is the Small Size League?</h2>
      <p>
        The RoboCup Small Size League (SSL) is robot soccer between teams of small, fully autonomous robots. Nobody
        steers them during a match: cameras mounted above the field track every robot and the ball, and each team's
        software decides every move.
      </p>

      <dl class="limits">
        {
          LIMITS.map(({ value, label }) => (
            <div>
              <dt>{label}</dt>
              <dd>{value}</dd>
            </div>
          ))
        }
      </dl>

      <p class="links">
        <a href="/about/">About the team</a>
        <a href="/robots/">Our robots</a>
      </p>
    </div>

    <figure class="ssl-media">
      <Picture
        src={lineup}
        formats={['avif', 'webp']}
        widths={[400, 640, 960, 1280]}
        sizes="(min-width: 960px) 560px, calc(100vw - 2rem)"
        alt="A row of black Immortals robots with colour-marker tops lined up on a green Small Size League field"
      />
      <figcaption>The coloured markers on top let the overhead cameras tell the robots apart.</figcaption>
    </figure>
  </div>
</section>

<style>
  .ssl {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    align-items: center;
    gap: clamp(2rem, 5vw, 4rem);
  }

  .ssl-copy > p {
    margin-top: 1rem;
    color: var(--text-muted);
    font-size: 1.0625rem;
  }

  .limits {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.75rem;
    margin-top: 1.75rem;
  }

  .limits div {
    display: flex;
    flex-direction: column-reverse;
    justify-content: flex-end;
    gap: 0.25rem;
    padding: 1rem;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--surface);
  }

  .limits dd {
    color: var(--heading);
    font-size: clamp(1.4rem, 3vw, 1.9rem);
    font-weight: 800;
    letter-spacing: -0.02em;
    line-height: 1.1;
  }

  .limits dt {
    color: var(--text-muted);
    font-size: 0.85rem;
    line-height: 1.3;
  }

  .ssl-copy > .links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
    margin-top: 1.5rem;
    font-weight: 600;
  }

  .ssl-media :global(img) {
    width: 100%;
    aspect-ratio: 4 / 3;
    border-radius: var(--radius);
    box-shadow: var(--shadow);
    object-fit: cover;
  }

  figcaption {
    margin-top: 0.6rem;
    color: var(--text-muted);
    font-size: 0.9rem;
  }

  @media (max-width: 860px) {
    .ssl {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 420px) {
    .limits div {
      padding: 0.75rem;
    }
  }
</style>
