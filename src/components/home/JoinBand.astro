---
import { SITE } from '../../data/site';
---

<section class="join" aria-labelledby="join-title">
  <div class="container">
    <div class="panel">
      <div class="join-intro">
        <span class="eyebrow">Get involved</span>
        <h2 id="join-title">Build the next generation with us</h2>
        <p>Whether you want to work on the robots or help them get to the next RoboCup, we'd like to hear from you.</p>
        <div class="actions">
          <a class="btn" href="/contact/">Get in touch</a>
          <a class="email" href={`mailto:${SITE.email}`}>{SITE.email}</a>
        </div>
      </div>

      <div class="paths">
        <div class="path">
          <h3>Join the team</h3>
          <p>Mechanics, electronics or software: there is a part of the robot for every interest.</p>
        </div>
        <div class="path">
          <h3>Sponsor us</h3>
          <p>Hardware, travel and competition fees add up. Sponsors make each season possible.</p>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .join {
    padding-top: clamp(2.5rem, 7vw, 5rem);
  }

  .panel {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: 1.75rem clamp(2rem, 5vw, 4rem);
    align-items: center;
    padding: clamp(1.5rem, 5vw, 3.5rem);
    border: 1px solid var(--border);
    border-radius: calc(var(--radius) * 1.6);
    background: var(--accent-soft);
  }

  .join-intro p {
    margin-top: 0.75rem;
    color: var(--text-muted);
    font-size: 1.0625rem;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1.5rem;
    margin-top: 1.5rem;
  }

  .email {
    font-weight: 600;
    overflow-wrap: anywhere;
  }

  .paths {
    display: grid;
    gap: 1rem;
  }

  .path {
    padding: 1.25rem 1.5rem;
    border: 1px solid var(--border);
    border-left: 4px solid var(--accent);
    border-radius: var(--radius);
    background: var(--surface);
  }

  .path h3 {
    font-size: 1.1rem;
  }

  .path p {
    margin-top: 0.35rem;
    color: var(--text-muted);
  }

  @media (max-width: 860px) {
    .panel {
      grid-template-columns: 1fr;
    }
  }
</style>
