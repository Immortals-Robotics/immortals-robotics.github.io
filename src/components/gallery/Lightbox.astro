---
// Photo viewer for links marked a[data-lightbox="<album id>"]. Progressive
// enhancement: without JS the links simply open the large image. Navigation
// stays within the album named by data-lightbox. Include once per page.
---

<dialog class="lightbox" aria-label="Photo viewer">
  <div class="lb-bar">
    <span class="lb-counter"></span>
    <button class="lb-btn lb-close" type="button" aria-label="Close">
      <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true">
        <path d="M6 6l12 12M18 6L6 18" stroke="currentColor" stroke-width="2" stroke-linecap="round"></path>
      </svg>
    </button>
  </div>
  <div class="lb-stage">
    <img class="lb-img" alt="" sizes="100vw" />
  </div>
  <div class="lb-bar">
    <button class="lb-btn lb-prev" type="button" aria-label="Previous photo">
      <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true">
        <path d="M15 5l-7 7 7 7" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path>
      </svg>
    </button>
    <p class="lb-caption" aria-live="polite"></p>
    <button class="lb-btn lb-next" type="button" aria-label="Next photo">
      <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true">
        <path d="M9 5l7 7-7 7" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path>
      </svg>
    </button>
  </div>
</dialog>

<script>
  const dialog = document.querySelector<HTMLDialogElement>('dialog.lightbox')!;
  const img = dialog.querySelector<HTMLImageElement>('.lb-img')!;
  const caption = dialog.querySelector<HTMLElement>('.lb-caption')!;
  const counter = dialog.querySelector<HTMLElement>('.lb-counter')!;
  const stage = dialog.querySelector<HTMLElement>('.lb-stage')!;

  let links: HTMLAnchorElement[] = [];
  let index = 0;
  let opener: HTMLAnchorElement | null = null;

  function show(i: number) {
    index = (i + links.length) % links.length;
    const link = links[index];
    const thumb = link.querySelector('img');
    const alt = thumb?.alt ?? '';
    const text = link.dataset.caption;

    img.removeAttribute('src'); // drop the old photo instead of showing it while the next one loads
    img.srcset = link.dataset.srcset ?? '';
    img.width = Number(link.dataset.width);
    img.height = Number(link.dataset.height);
    img.alt = alt;
    img.src = link.href;

    // Fall back to the alt text as a visible caption; hide that copy from screen readers.
    caption.textContent = text || alt;
    caption.toggleAttribute('aria-hidden', !text);
    counter.textContent = `${index + 1} / ${links.length}`;
  }

  document.addEventListener('click', (e) => {
    const link = (e.target as Element).closest<HTMLAnchorElement>('a[data-lightbox]');
    if (!link || e.button !== 0 || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;
    e.preventDefault();
    opener = link;
    links = [...document.querySelectorAll<HTMLAnchorElement>(`a[data-lightbox="${link.dataset.lightbox}"]`)];
    dialog.classList.toggle('single', links.length < 2);
    show(links.indexOf(link));
    document.documentElement.classList.add('lightbox-open');
    dialog.showModal();
  });

  dialog.querySelector('.lb-close')!.addEventListener('click', () => dialog.close());
  dialog.querySelector('.lb-prev')!.addEventListener('click', () => show(index - 1));
  dialog.querySelector('.lb-next')!.addEventListener('click', () => show(index + 1));

  // The dialog covers the viewport, so its empty area acts as the backdrop.
  dialog.addEventListener('click', (e) => {
    if (e.target === dialog || e.target === stage) dialog.close();
  });

  dialog.addEventListener('keydown', (e) => {
    if (links.length < 2) return;
    if (e.key === 'ArrowLeft') show(index - 1);
    else if (e.key === 'ArrowRight') show(index + 1);
  });

  // Escape closes natively; this runs for every way of closing.
  dialog.addEventListener('close', () => {
    document.documentElement.classList.remove('lightbox-open');
    opener?.focus();
  });
</script>

<style>
  :global(html.lightbox-open) {
    overflow: hidden;
    scrollbar-gutter: stable;
  }

  /* 100vw so it also covers the scrollbar gutter kept while scrolling is locked. */
  .lightbox {
    width: 100vw;
    max-width: none;
    height: 100%;
    max-height: none;
    padding: 0;
    border: 0;
    background: var(--bg);
    color: var(--text);
  }

  .lightbox[open] {
    display: grid;
    grid-template-rows: auto minmax(0, 1fr) auto;
  }

  .lightbox::backdrop {
    background: transparent;
  }

  .lb-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.75rem var(--gutter);
  }

  .lb-counter {
    color: var(--text-muted);
    font-size: 0.95rem;
    font-variant-numeric: tabular-nums;
  }

  /* The image is centred absolutely so max-height resolves against the stage. */
  .lb-stage {
    position: relative;
  }

  .lb-img {
    position: absolute;
    inset: 0 var(--gutter);
    width: auto;
    max-width: calc(100% - 2 * var(--gutter));
    height: auto;
    max-height: 100%;
    margin: auto;
    border-radius: var(--radius-sm);
    background: var(--surface-2);
    box-shadow: var(--shadow-lg);
  }

  .lb-caption {
    flex: 1;
    max-width: 65ch;
    color: var(--text);
    text-align: center;
  }

  .lb-btn {
    display: grid;
    flex: none;
    place-items: center;
    width: 44px;
    height: 44px;
    padding: 0;
    border: 1px solid var(--border);
    border-radius: 50%;
    background: var(--surface);
    color: var(--text);
    box-shadow: var(--shadow);
    cursor: pointer;
  }

  .lb-btn:hover {
    border-color: var(--accent);
    color: var(--accent);
  }

  .single .lb-prev,
  .single .lb-next {
    visibility: hidden;
  }
</style>
