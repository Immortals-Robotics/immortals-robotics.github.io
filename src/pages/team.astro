---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import MemberCard from '../components/team/MemberCard.astro';

const members = (await getCollection('team')).sort((a, b) => a.data.order - b.data.order);
const current = members.filter((m) => !m.data.alumni);
const alumni = members.filter((m) => m.data.alumni);
---

<Layout title="Team" description="The people behind the Immortals RoboCup Small Size League team.">
  <header class="container page-header">
    <span class="eyebrow">Team</span>
    <h1>The people behind the robots</h1>
    <p>
      Immortals is a team of computer and electrical engineers dedicated to advancing robotics
      technology through the RoboCup Small Size League.
    </p>
  </header>

  <section class="container" aria-labelledby="current-heading">
    <h2 id="current-heading" class="visually-hidden">Current members</h2>
    <ul class="grid members" role="list">
      {
        current.map((member) => (
          <li>
            <MemberCard member={member} />
          </li>
        ))
      }
    </ul>
  </section>

  {
    alumni.length > 0 && (
      <section class="container alumni" aria-labelledby="alumni-heading">
        <h2 id="alumni-heading">Alumni</h2>
        <p class="muted">Former members who helped build Immortals.</p>
        <ul class="grid members" role="list">
          {alumni.map((member) => (
            <li>
              <MemberCard member={member} />
            </li>
          ))}
        </ul>
      </section>
    )
  }

  <section class="container">
    <div class="join">
      <div>
        <h2>Want to join?</h2>
        <p class="muted">We're always looking for talented people to join us.</p>
      </div>
      <a class="btn" href="/contact/#join">How to join</a>
    </div>
  </section>
</Layout>

<style>
  .members {
    padding: 0;
    list-style: none;
  }

  .alumni {
    margin-top: clamp(2.5rem, 6vw, 4rem);
  }

  .alumni > p {
    margin-top: 0.4rem;
  }

  .alumni .members {
    margin-top: 1.5rem;
  }

  .join {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem 2rem;
    margin-top: clamp(2.5rem, 6vw, 4rem);
    padding: clamp(1.25rem, 4vw, 2rem);
    border-radius: var(--radius);
    background: var(--surface-2);
  }

  .join h2 {
    font-size: 1.5rem;
  }

  .join p {
    margin-top: 0.35rem;
  }
</style>
