---
import Layout from '../layouts/Layout.astro';
import TeamMember from '../components/TeamMember.astro';

const title = "Team Members";
---

<Layout title={title}>
<div class="team-page">
  <h1>Our Team</h1>
  
  <p class="team-intro">
    The Immortals team consists of talented computer and electrical engineers dedicated to advancing robotics technology through the RoboCup Small Size League competition.
  </p>
  
  <div class="team-grid">
    <TeamMember name="Ali Salehi" role="Team Member" />
    <TeamMember name="Mohammad Shirazi" role="Team Member" />
    <TeamMember name="Sina Sharafzadeh" role="Team Member" />
  </div>
</div>

<style>
  .team-page {
    padding: 2rem 0;
  }
  
  h1 {
    text-align: center;
    margin-bottom: 0.5rem;
    color: var(--primary);
  }
  
  .team-intro {
    text-align: center;
    max-width: 800px;
    margin: 0 auto 3rem;
    font-size: 1.1rem;
  }
  
  .team-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 2rem;
  }
</style>
